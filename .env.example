# Copia este archivo a .env.local y llena los valores.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# Supabase > Project Settings > API
# La Project URL tiene el formato: el ref del proyecto + .supabase.co
VITE_SUPABASE_URL=pega-aqui-la-project-url
# Usa la llave publica (anon / publishable). NUNCA la service_role.
VITE_SUPABASE_ANON_KEY=pega-aqui-la-llave-publica

# Solo si sigues usando el backend de Express en local (backend/).
# El flujo nuevo no lo necesita: el chat vive en la Edge Function
# chat-orientador y se llama con src/lib/api.ts.
# VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Lo siguiente NO va aqui ni en Vercel. Son secretos de Supabase y se ponen
# con el CLI (una sola vez):
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set MODEL_CHAT=gpt-4o-mini
#   supabase secrets set MODEL_REPORTE=gpt-4o
#   supabase secrets set MODEL_EMBED=text-embedding-3-small
#   supabase secrets set LLM_GASTO_MAX_USD_DIA=5
#
# Opcionales:
#   CORS_ORIGIN      dominio exacto del front en produccion (por defecto *)
#   OPENAI_BASE_URL  para apuntar a un proxy o a Azure OpenAI
#
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY ya las inyecta
# Supabase en las funciones: no las declares.
